# Reflection-subgroup index from the SW2 Coxeter presentation.
F:=FreeGroup(4);
s:=GeneratorsOfGroup(F);
W:=F/Concatenation(List(s,x->x^2),List([[1,2,2],[1,3,2],[1,4,3],[2,3,4],[2,4,2],[3,4,4]],
    e->(s[e[1]]*s[e[2]])^e[3]));
r:=GeneratorsOfGroup(W);
words:=[[4, 3, 2, 4, 3, 4, 2, 3, 4], [1, 4, 3, 2, 4, 3, 4, 2, 3, 4, 1], [2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2], [4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4], [1, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 1], [1, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 1], [2, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 2], [3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3], [3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3], [1, 2, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 2, 1], [1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1], [1, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 1], [2, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 2], [2, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 2], [3, 2, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 2, 3], [1, 2, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 2, 1], [1, 2, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 2, 1], [1, 3, 2, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 2, 3, 1], [2, 3, 2, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 2, 3, 2], [3, 2, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 2, 3], [1, 2, 3, 2, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 2, 3, 2, 1], [1, 3, 2, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 2, 3, 1], [2, 3, 2, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 2, 3, 2], [1, 2, 3, 2, 3, 4, 1, 3, 2, 4, 3, 4, 2, 3, 1, 4, 3, 2, 3, 2, 1], [4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4], [1, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 1], [2, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 2], [1, 2, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 2, 1], [3, 2, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 2, 3], [1, 3, 2, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 2, 3, 1], [2, 3, 2, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 2, 3, 2], [1, 2, 3, 2, 4, 1, 3, 4, 1, 3, 2, 4, 3, 2, 4, 3, 4, 2, 3, 4, 2, 3, 1, 4, 3, 1, 4, 2, 3, 2, 1]];
